# Gemini is optional; without it Jarvy remains usable with the deterministic local tools.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
JARVY_DATA_DIR=~/.jarvy
JARVY_ALLOWED_DIRS=["~/Documents","~/Downloads"]
JARVY_MAX_STEPS=8
JARVY_DRY_RUN=false
JARVY_HOST=127.0.0.1
JARVY_PORT=8000
